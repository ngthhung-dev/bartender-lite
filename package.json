{
  "name": "bartender-lite",
  "version": "1.0.0",
  "description": "Bartender Lite by ngthhung",
  "main": "main.js",
  "author": {
    "name": "ngthhung",
    "email": "ngthhung@example.com"
  },
  "homepage": "https://github.com/ngthhung/bartender-lite",
  "build": {
    "appId": "com.ngthhung.bartenderlite",
    "productName": "Bartender Lite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "json",
        "name": "Bartender Lite Template",
        "description": "Bartender Lite Template",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Bartender-Lite-${version}-build${env.BUILD_NUMBER}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "ngthhung <ngthhung@example.com>"
    },
    "mac": {
      "target": [
        {
          "target": "pkg"
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Bartender-Lite-${version}-build${env.BUILD_NUMBER}-macOS-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "bartender-lite_${version}-build${env.BUILD_NUMBER}_${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ngthhung-dev/bartender-lite.git"
  }
}