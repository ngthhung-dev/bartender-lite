{
  "name": "bartender-lite",
  "version": "1.0.0",
  "description": "Bartender Lite by ngthhung",
  "main": "main.js",
  "author": {
    "name": "ngthhung",
    "url": "https://github.com/ngthhung-dev"
  },
  "homepage": "https://github.com/ngthhung-dev/bartender-lite",
  "build": {
    "appId": "com.ngthhung.bartenderlite",
    "productName": "Bartender Lite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "json",
        "name": "Bartender Lite Template",
        "description": "Bartender Lite Template",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Bartender-Lite-${version}-build${env.BUILD_NUMBER}-Setup.${ext}",
      "legalTrademarks": "ngthhung"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1066",
      "installerLanguages": [
        "vi_VN"
      ]
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "ngthhung <ngthhung@users.noreply.github.com>",
      "vendor": "ngthhung",
      "synopsis": "Bartender Lite by ngthhung",
      "description": "Bartender Lite by ngthhung - thiet ke tem nhan, nap Excel, in va xuat PDF."
    },
    "mac": {
      "target": [
        {
          "target": "dir"
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleGetInfoString": "Bartender Lite by ngthhung"
      }
    },
    "deb": {
      "artifactName": "bartender-lite_${version}-build${env.BUILD_NUMBER}_${arch}.${ext}"
    },
    "copyright": "Copyright © 2026 ngthhung"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ngthhung-dev/bartender-lite.git"
  },
  "scripts": {
    "postinstall": "node scripts/patch-nsis-vi.js"
  }
}
